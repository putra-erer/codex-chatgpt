# Copy to .env; never commit real credentials. Use Node.js 24 LTS.
# Generate a DIFFERENT value for each password and AUTH_SECRET:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
POSTGRES_DB=company_gis
POSTGRES_USER=gis_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
POSTGRES_PORT=5432
APP_PORT=3000

# For npm commands on the host. Replace placeholders with URL-encoded passwords.
# Hex passwords generated above need no additional URL encoding.
# Docker composes its internal URLs using the settings above, with host=db.
DATABASE_URL=postgresql://gis_app:REPLACE_APP_PASSWORD@localhost:5432/company_gis
MIGRATION_DATABASE_URL=postgresql://gis_owner:REPLACE_OWNER_PASSWORD@localhost:5432/company_gis

# Google OAuth web client. Development redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Exact, comma-separated Google emails; matching verified accounts are promoted
# to APPROVED/ADMIN on every login. Remove after bootstrap if appropriate.
SUPER_ADMIN_EMAILS=
